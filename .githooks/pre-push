#!/bin/sh
set -eu

# Optional machine-local pre-push checks. Not version-controlled; skipped if absent.
#
# Anything under .git/ cannot be committed, so a contributor can keep private
# checks there without imposing them on anyone else. exec passes through the ref
# list git supplies on stdin, and the local hook's exit status becomes this one.
LOCAL_HOOK="$(git rev-parse --absolute-git-dir)/local-hooks/pre-push"
if [ -x "$LOCAL_HOOK" ]; then
  exec "$LOCAL_HOOK" "$@"
fi

exit 0
